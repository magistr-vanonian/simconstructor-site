# Скопируйте в .env.deploy и заполните. Файл .env.deploy в git не попадает.
# В чат логин/пароль не пишите.

PUBLIC_ORIGIN=https://historyengine.ru

# SSH на VPS (IP из панели хостинга)
DEPLOY_HOST=
DEPLOY_PORT=22
DEPLOY_USER=root

# Либо пароль, либо ключ. Ключ надёжнее.
DEPLOY_PASSWORD=
# DEPLOY_SSH_KEY=C:\Users\Iv\.ssh\id_ed25519

# Куда класть сайт на сервере
DEPLOY_PATH=/var/www/historyengine
