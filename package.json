{
  "name": "simconstructor-site",
  "private": true,
  "version": "0.1.0",
  "description": "Промо-сайт конструктора симуляций Kristal",
  "scripts": {
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently -n api,web -c yellow,cyan \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build",
    "start": "node server/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mime-types": "^2.1.35",
    "archiver": "^7.0.1",
    "multer": "^1.4.5-lts.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
